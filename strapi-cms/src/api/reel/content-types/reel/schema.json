{
  "kind": "collectionType",
  "collectionName": "reels",
  "info": {
    "singularName": "reel",
    "pluralName": "reels",
    "displayName": "Reel",
    "description": "Video reels for the hero carousel"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "subtitle": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "required": true
    },
    "location": {
      "type": "string"
    },
    "duration": {
      "type": "string"
    },
    "badge": {
      "type": "string"
    },
    "video": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["videos"]
    },
    "posterImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "posterUrl": {
      "type": "text"
    },
    "likes": {
      "type": "integer",
      "default": 0
    },
    "description": {
      "type": "richtext"
    },
    "instagramUrl": {
      "type": "string"
    },
    "instagramPostId": {
      "type": "string"
    },
    "approvalStatus": {
      "type": "enumeration",
      "enum": ["pending", "approved", "archived"],
      "default": "approved"
    }
  }
}
